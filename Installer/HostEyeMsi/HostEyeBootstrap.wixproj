<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>HostEyeBootstrap</OutputName>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <SourceDir>$(MSBuildThisFileDirectory)..\..\VectorBuild</SourceDir>
    <GatewayUri>https://agent.hosteye.iahn.hanoi.vn/api/v1/telemetry</GatewayUri>
    <DefineConstants>SourceDir=$(SourceDir);GatewayUri=$(GatewayUri)</DefineConstants>
  </PropertyGroup>
</Project>

