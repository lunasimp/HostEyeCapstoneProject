{
  "GatewayUri": "http://localhost:8088/api/v1/telemetry",
  "ConfigUri": "http://localhost:8080/api/v1/agent/config",
  "AdmissionUri": "http://localhost:8080/api/v1/admission/request",
  "GroupId": "default",
  "AgentConfigSigningKey": "hosteye-dynamic-config-demo-key",
  "SpoolDirectory": "spool",
  "StateDirectory": "shipper_state",
  "LogDirectory": "logs",
  "ClientCertificateFile": "certs/client.crt",
  "ClientKeyFile": "certs/client.key",
  "CaCertificateFile": "certs/company_ca.crt",
  "AllowSystemServerCertificateTrust": true,
  "MaxEvents": 500,
  "MaxBytes": 524288,
  "StartupJitterWindowSeconds": 300,
  "NormalJitterWindowSeconds": 5,
  "RecoveryJitterWindowSeconds": 30,
  "BaseBackoffSeconds": 2,
  "MaxBackoffSeconds": 120,
  "MaxSpoolSizeMB": 2048,
  "LowWatermarkPercent": 80,
  "SpoolCheckIntervalSeconds": 10,
  "ConfigSyncIntervalSeconds": 1800,
  "ConfigSyncJitterSeconds": 300,
  "PreferDeletingSentFirst": true,
  "SentRetentionDays": 1,
  "RunOnce": false
}
