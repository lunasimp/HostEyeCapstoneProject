{
  "SysmonEnabledEventIds": [1, 3, 7, 8, 10, 11, 12, 13, 22, 25],
  "NeverSuppressSysmonEventIds": [8, 25],
  "NoiseGroupKey": ["host_id", "event_id", "source_image", "target_prefix", "event_type"],
  "MaxRawEventsPerMinutePerNoiseGroup": 10,
  "ImplementationNote": "Current Vector config aggregates matching low-value noise groups into summaries instead of keeping 10 raw samples. EID 8 and 25 are never suppressed; EID 10 is only suppressed for known low-value system access and keeps sensitive targets/sources raw.",
  "SuppressionRules": [
    {
      "id": "SYS_REG_WBEM_SVCHOST_CREATEKEY_NOISE",
      "version": "1.0.0",
      "reason": "Repeated low-value WMI registry CreateKey/DeleteKey activity from svchost.exe",
      "eventIds": [12],
      "eventTypes": ["CreateKey", "DeleteKey"],
      "sourceImageEndsWith": "\\svchost.exe",
      "targetObjectPrefix": "HKLM\\SOFTWARE\\Microsoft\\Wbem",
      "aggregateWindowSeconds": 60,
      "sensitiveRegistryKeywords": [
        "\\CurrentVersion\\Run",
        "\\CurrentVersion\\RunOnce",
        "\\CurrentControlSet\\Services",
        "\\CurrentVersion\\Winlogon",
        "\\Image File Execution Options",
        "\\AppInit_DLLs",
        "\\Control\\Lsa",
        "\\Lsa",
        "\\Security Providers",
        "\\Windows Defender\\Exclusions",
        "\\FirewallPolicy",
        "\\Terminal Server",
        "\\Schedule\\TaskCache",
        "\\Subscription",
        "\\WMI"
      ]
    },
    {
      "id": "SYS_PROC_ACCESS_SYSTEM_NOISE",
      "version": "1.0.0",
      "reason": "Repeated low-value Sysmon process access from known Windows process",
      "eventIds": [10],
      "aggregateWindowSeconds": 60,
      "knownSystemSourceImageEndsWith": [
        "\\svchost.exe",
        "\\csrss.exe",
        "\\dwm.exe",
        "\\taskhostw.exe",
        "\\explorer.exe",
        "\\runtimebroker.exe",
        "\\searchindexer.exe"
      ],
      "neverSuppressTargetImageEndsWith": [
        "\\lsass.exe",
        "\\winlogon.exe",
        "\\services.exe"
      ],
      "neverSuppressTargetKeywords": ["\\sam", "\\security"],
      "neverSuppressSourceImageEndsWith": [
        "\\powershell.exe",
        "\\cmd.exe",
        "\\rundll32.exe",
        "\\regsvr32.exe",
        "\\mshta.exe",
        "\\wscript.exe",
        "\\cscript.exe",
        "\\python.exe",
        "\\node.exe"
      ],
      "suspiciousGrantedAccessContains": [
        "0x1f0fff",
        "0x1fffff",
        "0x143a",
        "0x1410",
        "0x1010"
      ],
      "preserveFields": ["CallTrace"]
    }
  ]
}
