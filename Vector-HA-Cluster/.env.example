# Copy this file to .env before starting the authenticated Dashboard stack.
HOSTEYE_DASHBOARD_BOOTSTRAP_ADMIN_USERNAME=admin
HOSTEYE_DASHBOARD_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-secret-of-at-least-16-characters
HOSTEYE_DASHBOARD_SESSION_TTL_MINUTES=480
HOSTEYE_DASHBOARD_CORS_ORIGIN=http://localhost:5174
